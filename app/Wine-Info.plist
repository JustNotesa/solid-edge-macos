<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Kommt als Info.plist nach wine/lib/wine/x86_64-unix (build-dmg.sh, launcher.sh). Damit gilt der Ordner für macOS
     als (flaches) App-Bundle mit dem Wine-Lader „wine“ als Programm: Dock, Cmd-Tab und Menüleiste zeigen „Solid Edge
     2026“ statt „wine“. Inhalt sonst wie Wines eingebettete Info.plist (Abschnitt __TEXT,__info_plist im Lader).
     Eigene Kennung (nicht die der App), damit macOS beim Öffnen per Kennung nicht den Wine-Ordner startet. -->
<plist version="1.0">
<dict>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>wine</string>
	<key>CFBundleIdentifier</key>
	<string>local.wine.solidedge2026.wine</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Solid Edge 2026</string>
	<key>CFBundleDisplayName</key>
	<string>Solid Edge 2026</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>NSPrincipalClass</key>
	<string>WineApplication</string>
	<key>LSUIElement</key>
	<string>1</string>
</dict>
</plist>
