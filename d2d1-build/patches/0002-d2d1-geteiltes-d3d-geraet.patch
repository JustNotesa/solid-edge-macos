diff -ruN a/dlls/d2d1/shared.c b/dlls/d2d1/shared.c
--- a/dlls/d2d1/shared.c
+++ b/dlls/d2d1/shared.c
@@ -0,0 +1,298 @@
+/*
+ * Shared Direct3D device for d2d1 factories, plus object statistics.
+ *
+ * Wine's d2d1 creates one D3D10 device per ID2D1Factory (d2d_factory_get_device()) for DC, WIC and HWND
+ * render targets. On Windows a factory is cheap; with DXVK every D3D device is a full Vulkan device with
+ * its own submit/queue/CS threads and state-cache workers (~10 threads). Applications that create many
+ * factories (Solid Edge / Codejock ToolkitPro: >200 on the UI thread) therefore end up with thousands of
+ * threads. Single-threaded factories created on the same thread now share one device, which stays cached
+ * until that thread exits. Within a thread, all D2D work is serialised anyway; factories of different threads
+ * keep separate devices, and multi-threaded factories keep their own device as before.
+ *
+ *   D2D1_SHARED_DEVICE=thread   (default) one device per creating thread
+ *   D2D1_SHARED_DEVICE=process  one device for the whole process
+ *   D2D1_SHARED_DEVICE=0        Wine behaviour: one device per factory
+ *
+ * WINEDEBUG=+d2dstat logs factory/device/render-target/SVG lifetimes with running totals.
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+
+#include <stdlib.h>
+#include "d2d1_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d2d);
+WINE_DECLARE_DEBUG_CHANNEL(d2dstat);
+
+struct d2d_shared_device
+{
+    struct list entry;
+    DWORD key;
+    ID3D10Device1 *device; /* Reference owned by the cache. */
+};
+
+static struct list d2d_shared_devices = LIST_INIT(d2d_shared_devices);
+static CRITICAL_SECTION d2d_shared_cs;
+static CRITICAL_SECTION_DEBUG d2d_shared_cs_debug =
+{
+    0, 0, &d2d_shared_cs,
+    {&d2d_shared_cs_debug.ProcessLocksList, &d2d_shared_cs_debug.ProcessLocksList},
+      0, 0, {(DWORD_PTR)(__FILE__ ": d2d_shared_cs")}
+};
+static CRITICAL_SECTION d2d_shared_cs = {&d2d_shared_cs_debug, -1, 0, 0, 0, 0};
+
+enum d2d_shared_mode
+{
+    D2D_SHARED_OFF,
+    D2D_SHARED_THREAD,
+    D2D_SHARED_PROCESS,
+};
+
+static enum d2d_shared_mode d2d_shared_mode(void)
+{
+    static LONG mode = -1;
+    char buf[16];
+    LONG m;
+
+    if ((m = ReadNoFence(&mode)) >= 0)
+        return m;
+
+    m = D2D_SHARED_THREAD;
+    if (GetEnvironmentVariableA("D2D1_SHARED_DEVICE", buf, sizeof(buf)) && buf[0])
+    {
+        if (!strcmp(buf, "0") || !_stricmp(buf, "off") || !_stricmp(buf, "factory"))
+            m = D2D_SHARED_OFF;
+        else if (!_stricmp(buf, "process") || !_stricmp(buf, "global"))
+            m = D2D_SHARED_PROCESS;
+    }
+    InterlockedExchange(&mode, m);
+    TRACE_(d2dstat)("shared device mode %ld.\n", m);
+    return m;
+}
+
+static LONG d2d_stat_counts[D2D_STAT_COUNT];
+static LONG d2d_stat_totals[D2D_STAT_COUNT];
+static const char * const d2d_stat_names[D2D_STAT_COUNT] =
+{
+    "factory", "d3d_device", "d2d_device", "dc_rt", "wic_rt", "hwnd_rt", "svg_doc", "shader_compile",
+};
+
+void d2d_stat_event(enum d2d_stat_kind kind, LONG delta, const void *object)
+{
+    LONG alive = InterlockedExchangeAdd(&d2d_stat_counts[kind], delta) + delta;
+
+    if (delta > 0)
+        InterlockedExchangeAdd(&d2d_stat_totals[kind], delta);
+    if (!TRACE_ON(d2dstat))
+        return;
+    TRACE_(d2dstat)("%s%c %p tid %04lx | alive: factory %ld, d3d_device %ld, d2d_device %ld, dc_rt %ld, "
+            "wic_rt %ld, hwnd_rt %ld, svg %ld | created: factory %ld, d3d_device %ld, d2d_device %ld, "
+            "dc_rt %ld, svg %ld, shader_compile %ld (alive %s now %ld)\n",
+            d2d_stat_names[kind], delta > 0 ? '+' : '-', object, GetCurrentThreadId(),
+            d2d_stat_counts[D2D_STAT_FACTORY], d2d_stat_counts[D2D_STAT_D3D_DEVICE],
+            d2d_stat_counts[D2D_STAT_D2D_DEVICE], d2d_stat_counts[D2D_STAT_DC_RT],
+            d2d_stat_counts[D2D_STAT_WIC_RT], d2d_stat_counts[D2D_STAT_HWND_RT],
+            d2d_stat_counts[D2D_STAT_SVG_DOC], d2d_stat_totals[D2D_STAT_FACTORY],
+            d2d_stat_totals[D2D_STAT_D3D_DEVICE], d2d_stat_totals[D2D_STAT_D2D_DEVICE],
+            d2d_stat_totals[D2D_STAT_DC_RT], d2d_stat_totals[D2D_STAT_SVG_DOC],
+            d2d_stat_totals[D2D_STAT_SHADER_COMPILE], d2d_stat_names[kind], alive);
+}
+
+void d2d_stat_refs(ID3D10Device1 *device, const char *where)
+{
+    ULONG refs;
+
+    if (!device || !TRACE_ON(d2dstat))
+        return;
+    ID3D10Device1_AddRef(device);
+    refs = ID3D10Device1_Release(device);
+    TRACE_(d2dstat)("refs %p %s: %lu\n", device, where, refs);
+}
+
+static HRESULT d2d_create_d3d_device(ID3D10Device1 **device)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = D3D10CreateDevice1(NULL, D3D10_DRIVER_TYPE_HARDWARE, NULL, D3D10_CREATE_DEVICE_BGRA_SUPPORT,
+            D3D10_FEATURE_LEVEL_10_0, D3D10_1_SDK_VERSION, device)))
+    {
+        WARN("Failed to create device, hr %#lx.\n", hr);
+        return hr;
+    }
+    d2d_stat_event(D2D_STAT_D3D_DEVICE, 1, *device);
+    d2d_stat_refs(*device, "created");
+    return hr;
+}
+
+/* Locking rules (a loader-lock inversion here deadlocked Solid Edge's first start):
+ *  - d2d_shared_cs only protects the list. While holding it we only compare keys, link/unlink entries and AddRef;
+ *    never create or release a device, never load modules or start threads (DXVK does both and needs the loader
+ *    lock).
+ *  - Nothing in DllMain touches this cache. Thread exit is handled by a fiber-local-storage callback, which ntdll
+ *    runs before it takes the loader lock (LdrShutdownThread -> RtlProcessFlsData), and the device reference is
+ *    released from the thread pool, outside any lock. */
+static DWORD d2d_shared_fls = FLS_OUT_OF_INDEXES;
+static INIT_ONCE d2d_shared_fls_once = INIT_ONCE_STATIC_INIT;
+
+static void CALLBACK d2d_shared_device_release_cb(TP_CALLBACK_INSTANCE *instance, void *context)
+{
+    struct d2d_shared_device *shared = context;
+
+    TRACE_(d2dstat)("dropping cached d3d device %p of thread key %04lx.\n", shared->device, shared->key);
+    ID3D10Device1_Release(shared->device);
+    d2d_stat_event(D2D_STAT_D3D_DEVICE, -1, shared);
+    free(shared);
+}
+
+static void d2d_shared_device_release_later(struct d2d_shared_device *shared)
+{
+    if (!TrySubmitThreadpoolCallback(d2d_shared_device_release_cb, shared, NULL))
+        WARN("Failed to queue release of device %p, leaking it.\n", shared->device);
+}
+
+/* Fiber-local storage callback: runs when a thread that created a cached device exits (and on FlsFree). */
+static void WINAPI d2d_shared_device_fls_cb(void *data)
+{
+    struct d2d_shared_device *shared = data, *cur;
+    BOOL found = FALSE;
+
+    if (!shared)
+        return;
+    EnterCriticalSection(&d2d_shared_cs);
+    LIST_FOR_EACH_ENTRY(cur, &d2d_shared_devices, struct d2d_shared_device, entry)
+    {
+        if (cur != shared)
+            continue;
+        list_remove(&shared->entry);
+        found = TRUE;
+        break;
+    }
+    LeaveCriticalSection(&d2d_shared_cs);
+    if (found)
+        d2d_shared_device_release_later(shared);
+}
+
+static BOOL WINAPI d2d_shared_fls_init(INIT_ONCE *once, void *param, void **context)
+{
+    d2d_shared_fls = FlsAlloc(d2d_shared_device_fls_cb);
+    return TRUE;
+}
+
+/* Returns an AddRef'd cached device for key, or NULL. */
+static ID3D10Device1 *d2d_shared_device_lookup(DWORD key)
+{
+    struct d2d_shared_device *shared;
+    ID3D10Device1 *device = NULL;
+
+    EnterCriticalSection(&d2d_shared_cs);
+    LIST_FOR_EACH_ENTRY(shared, &d2d_shared_devices, struct d2d_shared_device, entry)
+    {
+        if (shared->key != key)
+            continue;
+        device = shared->device;
+        ID3D10Device1_AddRef(device);
+        break;
+    }
+    LeaveCriticalSection(&d2d_shared_cs);
+    return device;
+}
+
+/* Removes the entry for key if it still holds device; the caller releases it outside the lock. */
+static struct d2d_shared_device *d2d_shared_device_unlink(DWORD key, ID3D10Device1 *device)
+{
+    struct d2d_shared_device *shared, *found = NULL;
+
+    EnterCriticalSection(&d2d_shared_cs);
+    LIST_FOR_EACH_ENTRY(shared, &d2d_shared_devices, struct d2d_shared_device, entry)
+    {
+        if (shared->key != key || shared->device != device)
+            continue;
+        list_remove(&shared->entry);
+        found = shared;
+        break;
+    }
+    LeaveCriticalSection(&d2d_shared_cs);
+    return found;
+}
+
+/* Returns a new device reference for the caller (the factory). The cache keeps its own reference, so the
+ * device survives the typical "create factory, draw one icon, release everything" pattern. Without it, each
+ * factory would create a new device again; with DXVK 1.10 those are never destroyed anyway (the immediate
+ * context keeps the last ID3DDeviceContextState, which holds a public device reference -> cycle). */
+HRESULT d2d_shared_device_get(D2D1_FACTORY_TYPE factory_type, ID3D10Device1 **device)
+{
+    enum d2d_shared_mode mode = d2d_shared_mode();
+    struct d2d_shared_device *shared, *cur, *old;
+    ID3D10Device1 *existing;
+    DWORD key;
+    HRESULT hr;
+
+    /* Multi-threaded factories may be used from any thread; their render targets only lock their own
+     * factory, so they keep a private device. */
+    if (mode == D2D_SHARED_OFF || factory_type != D2D1_FACTORY_TYPE_SINGLE_THREADED)
+        return d2d_create_d3d_device(device);
+
+    key = mode == D2D_SHARED_THREAD ? GetCurrentThreadId() : 0;
+
+    if ((existing = d2d_shared_device_lookup(key)))
+    {
+        if (SUCCEEDED(hr = ID3D10Device1_GetDeviceRemovedReason(existing)))
+        {
+            TRACE_(d2dstat)("reusing d3d device %p for thread key %04lx.\n", existing, key);
+            *device = existing;
+            return S_OK;
+        }
+        WARN("Cached device %p was removed, hr %#lx; creating a new one.\n", existing, hr);
+        if ((old = d2d_shared_device_unlink(key, existing)))
+        {
+            if (mode == D2D_SHARED_THREAD && d2d_shared_fls != FLS_OUT_OF_INDEXES)
+                FlsSetValue(d2d_shared_fls, NULL);
+            d2d_shared_device_release_later(old);
+        }
+        ID3D10Device1_Release(existing);
+    }
+
+    /* Create the device without holding any lock. */
+    if (!(shared = calloc(1, sizeof(*shared))))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = d2d_create_d3d_device(&shared->device)))
+    {
+        free(shared);
+        return hr;
+    }
+    shared->key = key;
+    if (mode == D2D_SHARED_THREAD)
+        InitOnceExecuteOnce(&d2d_shared_fls_once, d2d_shared_fls_init, NULL, NULL);
+
+    EnterCriticalSection(&d2d_shared_cs);
+    existing = NULL;
+    LIST_FOR_EACH_ENTRY(cur, &d2d_shared_devices, struct d2d_shared_device, entry)
+    {
+        if (cur->key != key)
+            continue;
+        existing = cur->device; /* Lost a race (process mode): use the winner. */
+        ID3D10Device1_AddRef(existing);
+        break;
+    }
+    if (!existing)
+    {
+        list_add_tail(&d2d_shared_devices, &shared->entry);
+        ID3D10Device1_AddRef(shared->device);
+    }
+    LeaveCriticalSection(&d2d_shared_cs);
+
+    if (existing)
+    {
+        ID3D10Device1_Release(shared->device);
+        d2d_stat_event(D2D_STAT_D3D_DEVICE, -1, shared);
+        free(shared);
+        *device = existing;
+        return S_OK;
+    }
+    if (mode == D2D_SHARED_THREAD && d2d_shared_fls != FLS_OUT_OF_INDEXES)
+        FlsSetValue(d2d_shared_fls, shared);
+    *device = shared->device;
+    return S_OK;
+}
